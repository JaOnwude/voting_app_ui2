{
  "name": "voting-app-ui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:css": "bunx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css",
    "build:js": "bun build ./src/main.ts --outdir ./dist",
    "build": "bun run build:css && bun run build:js",
    "dev:css": "bunx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch",
    "dev:js": "bun build ./src/main.ts --outdir ./dist --watch",
    "dev": "bun run build && bunx serve ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/bun": "latest",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}